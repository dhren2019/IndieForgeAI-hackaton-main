{
  "name": "indieforge-ai",
  "version": "1.0.0",
  "description": "AI-powered content generator for indie game developers",
  "scripts": {
    "build":      "bun run scripts/build.ts",
    "dev":        "bun run scripts/dev.ts",
    "start":      "bun run scripts/build.ts && bun run src/server.ts",
    "db:migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/bun": "latest"
  }
}
