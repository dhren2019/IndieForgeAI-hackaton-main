{
  "name": "indieforge-ai",
  "version": "1.0.0",
  "description": "AI-powered content generator for indie game developers",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "start": "bun run scripts/build.ts && bun run src/server.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate-from-sqlite": "bun run scripts/migrate-sqlite-to-pg.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.2",
    "@clerk/clerk-react": "^5.61.3",
    "@gradio/client": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/bun": "latest"
  }
}
