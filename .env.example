# IndieForge AI — Plantilla de variables de entorno
# Copia este fichero a .env y rellena los valores reales.
# .env está en .gitignore — NUNCA lo subas al repositorio.

# ── Groq (generación de texto rápida y gratuita) ──────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── HuggingFace — modelo Qwen 0.6B fine-tuned + generación de imagen ─────
HF_TOKEN=hf_your_hf_token_here
HF_MODEL_URL=https://router.huggingface.co/hf-inference/models/Dhren/Qwen3-0.6B-heretic
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ── Base de datos — PostgreSQL (Neon, Supabase, Railway, etc.) ────────────
DATABASE_URL=postgresql://neondb_owner:npg_1c4sikTnfNGq@ep-polished-fire-amftihmp-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ── Clerk — autenticación de usuarios ─────────────────────────────────────────────
# Obtén estas claves en https://dashboard.clerk.com -> tu app -> API Keys
# AMBAS son necesarias para que el login funcione entre dispositivos.
